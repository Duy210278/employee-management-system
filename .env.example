# Sao chép thành .env rồi chỉnh nếu cần (mục 14.6 tài liệu thiết kế)
# SQL Server: tạo CSDL và tài khoản bằng scripts/setup-sqlserver.sql (xem README)
DATABASE_URL="Server=localhost,1433;Database=lotrinh;User Id=lotrinh_app;Password=<mật khẩu>;Encrypt=true;TrustServerCertificate=true"
# Cơ sở dữ liệu riêng cho test API, bị xóa sạch mỗi lần chạy test
DATABASE_URL_TEST="Server=localhost,1433;Database=lotrinh_test;User Id=lotrinh_app;Password=<mật khẩu>;Encrypt=true;TrustServerCertificate=true"
PORT=3000
JWT_SECRET=doi-chuoi-nay-thanh-chuoi-ngau-nhien
TZ=Asia/Ho_Chi_Minh
# Bật công cụ demo (không cung cấp đăng nhập riêng)
DEMO_MODE=true
STORAGE_DIR=./storage
# Cho phép xóa sạch CSDL không phải *_test (pnpm db:reset, nút Khôi phục dữ liệu mẫu). Chỉ bật trên máy dev
ALLOW_RESET=true
# Tự chạy migration khi API khởi động; đặt false khi DBA tự chạy script
AUTO_MIGRATE=true
# Trang tài liệu API (Swagger) ở /api/docs; đặt false để tắt
API_DOCS=true
# Để trống thì chỉ thông báo trong ứng dụng
SMTP_URL=
# SSO qua cookie của Web A giả lập. HOST_JWT_SECRET phải khớp FAKE_HOST_SECRET của fake-host.
HOST_AUTH_MODE=jwt
HOST_COOKIE_NAME=hostsid
HOST_JWT_SECRET=khoa-web-a-gia-chi-dung-tren-may-dev
HOST_ROLE_MAP={"NVBH":"nv","CHT":"cht","QLKV":"qlkv","DAO_TAO":"bp"}
HOST_LOGIN_URL=http://localhost:8080/dang-nhap
HOST_LOGOUT_URL=http://localhost:8080/dang-xuat
PUBLIC_URL=http://localhost:8080
# Đường dẫn gốc sau proxy cùng tên miền; phải đặt cả lúc build giao diện
BASE_PATH=/lo-trinh
